# =============================================================================
# ARQUIVO DE CONFIGURAÇÃO - MERCADO LIVRE TRACKER V2
# =============================================================================
# Copie este arquivo para .env e configure as variáveis conforme necessário
# =============================================================================

# =============================================================================
# CONFIGURAÇÕES DE SEGURANÇA
# =============================================================================
# Chave secreta para assinatura de tokens JWT (ALTERE EM PRODUÇÃO!)
SECRET_KEY=your_super_secret_key_here_change_this_in_production_environment
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# CONFIGURAÇÕES DO BANCO DE DADOS
# =============================================================================
# PostgreSQL - Banco de dados principal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=ml_tracker
DATABASE_URL=postgresql://postgres:postgres123@db:5432/ml_tracker

# =============================================================================
# CONFIGURAÇÕES DO REDIS
# =============================================================================
# Redis - Cache e sessões
REDIS_URL=redis://redis:6379/0

# =============================================================================
# CONFIGURAÇÕES DA OPENAI (OPCIONAL)
# =============================================================================
# Chave da API OpenAI para o assistente IA
# Obtenha sua chave em: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# =============================================================================
# CONFIGURAÇÕES DE EMAIL (OPCIONAL)
# =============================================================================
# Configurações SMTP para envio de notificações
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# =============================================================================
# CONFIGURAÇÕES DE URLS
# =============================================================================
# URLs dos serviços (ajuste conforme necessário)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# =============================================================================
# CONFIGURAÇÕES DO ELASTICSEARCH (OPCIONAL)
# =============================================================================
# Elasticsearch para busca avançada e análise
ELASTICSEARCH_URL=http://elasticsearch:9200

# =============================================================================
# CONFIGURAÇÕES DE AMBIENTE
# =============================================================================
# Ambiente de execução
ENVIRONMENT=development
DEBUG=true

# =============================================================================
# CONFIGURAÇÕES DE SCRAPING
# =============================================================================
# Configurações para o sistema de scraping
SCRAPING_INTERVAL=3600  # Intervalo entre scrapings em segundos
MAX_CONCURRENT_SCRAPES=5  # Máximo de scrapings simultâneos
SCRAPING_TIMEOUT=30  # Timeout para requests em segundos

# =============================================================================
# CONFIGURAÇÕES DE ALERTAS
# =============================================================================
# Configurações para sistema de alertas
ALERT_EMAIL_ENABLED=true
ALERT_SMS_ENABLED=false
ALERT_WEBHOOK_ENABLED=false

# =============================================================================
# CONFIGURAÇÕES DE LOG
# =============================================================================
# Configurações de logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5

# =============================================================================
# CONFIGURAÇÕES DE PERFORMANCE
# =============================================================================
# Configurações de performance
MAX_WORKERS=4
WORKER_TIMEOUT=300
REQUEST_TIMEOUT=30

# =============================================================================
# CONFIGURAÇÕES DE SEGURANÇA AVANÇADA
# =============================================================================
# Configurações de segurança adicional
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
CORS_CREDENTIALS=true
CORS_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]
CORS_HEADERS=["*"]

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# =============================================================================
# CONFIGURAÇÕES DE BACKUP
# =============================================================================
# Configurações de backup automático
BACKUP_ENABLED=true
BACKUP_INTERVAL=24  # Horas
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/app/backups

# =============================================================================
# CONFIGURAÇÕES DE MONITORAMENTO
# =============================================================================
# Configurações para monitoramento e métricas
MONITORING_ENABLED=true
METRICS_ENABLED=true
HEALTH_CHECK_INTERVAL=60  # Segundos

# =============================================================================
# CONFIGURAÇÕES DE DESENVOLVIMENTO
# =============================================================================
# Configurações específicas para desenvolvimento
DEV_MODE=true
HOT_RELOAD=true
DEBUG_TOOLBAR=true
PROFILING_ENABLED=false
